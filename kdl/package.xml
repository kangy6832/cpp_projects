<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kdl_tools</name>
  <version>0.1.0</version>
  <description>教学用的 KDL 工具：从 URDF 构建 KDL::Tree / KDL::Chain，并提供便利打印。</description>

  <maintainer email="kangy@example.com">kangy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>urdf</depend>
  <depend>kdl_parser</depend>
  <depend>orocos_kdl_vendor</depend>
  <!-- urdf::Model::initFile/initString 依赖 urdf_parser_plugin 插件在运行时被加载 -->
  <exec_depend>urdf_parser_plugin</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
